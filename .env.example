# ── Service URLs ──────────────────────────────────────────────────────────────
# Docker Compose uses service names; local dev uses localhost.
DOCLING_URL=http://docling:5001/v1/convert/source
OLLAMA_EMBED_URL=http://ollama:11434/api/embeddings
QDRANT_URL=http://qdrant:6333
FILE_SERVER_URL=http://fileserver:9900

# ── API Keys ──────────────────────────────────────────────────────────────────
# DOCLING_API_KEY=your-api-key-here

# ── Model / collection names ──────────────────────────────────────────────────
COLLECTION_NAME=personal_rag
EMBED_MODEL=bge-m3
RERANK_MODEL=BAAI/bge-reranker-base
SPARSE_MODEL=Qdrant/bm25
DENSE_DIM=1024

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MIN_CHUNK_LEN=30
CHUNK_STRATEGY=recursive

# ── HTTP client settings ──────────────────────────────────────────────────────
HTTP_TIMEOUT=60.0
DOCLING_TIMEOUT=300.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF=0.5

# ── Qdrant client settings ────────────────────────────────────────────────────
QDRANT_TIMEOUT=10.0
QDRANT_MAX_RETRIES=3

# ── Search settings ──────────────────────────────────────────────────────────
SEARCH_FUSION=rrf
RERANK_ENABLED=true
SEARCH_TOP_K=20

# ── MCP server settings ───────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_TRANSPORT=http

# ── Feature toggles ──────────────────────────────────────────────────────────
ENABLE_OCR=true
ENABLE_RERANKING=true

# ── Contextual Retrieval ────────────────────────────────────────────────────
ENABLE_CONTEXTUAL_RETRIEVAL=false
CONTEXT_STRATEGY=header  # header | summary | surrounding
CONTEXT_MODEL=""         # empty = use EMBED_MODEL
CONTEXT_PREFIX_MAX_TOKENS=50
CONTEXT_BATCH_SIZE=10

# ── Response limits ────────────────────────────────────────────────────────────
CHARACTER_LIMIT=25000

# ── Embedding batch size ─────────────────────────────────────────────────────
EMBED_BATCH_SIZE=32

# ── Query Expansion ─────────────────────────────────────────────────────────
# Enable query expansion for better retrieval of ambiguous/complex queries
ENABLE_QUERY_EXPANSION=false
ENABLE_HYDE=false              # Hypothetical Document Embeddings
ENABLE_MULTI_QUERY=false       # Generate multiple query variations
ENABLE_QUERY_REWRITE=false     # LLM-based query rewriting
HYDE_MODEL=""                  # empty = use EMBED_MODEL
MULTI_QUERY_COUNT=3            # Number of paraphrases to generate
MULTI_QUERY_MODEL=""           # empty = use default LLM
QUERY_REWRITE_MODEL=""         # empty = use default LLM

# ── Metadata Enhancement ────────────────────────────────────────────────────
# Enable rich metadata extraction for better filtering and retrieval
ENABLE_METADATA_EXTRACTION=false
ENABLE_ENTITY_EXTRACTION=false    # Extract people, orgs, dates, locations
ENABLE_DOC_CLASSIFICATION=false   # Classify document type
ENABLE_TOPIC_TAGGING=false        # Extract topic labels
ENABLE_LANGUAGE_DETECTION=true    # Detect document language
METADATA_MODEL=""                 # empty = use default LLM
MAX_ENTITIES_PER_CHUNK=10
MAX_TOPICS_PER_CHUNK=5

# ── Evaluation Framework ────────────────────────────────────────────────────
# Enable evaluation metrics and A/B testing
EVAL_ENABLED=false
EVAL_DATASET_PATH=evaluation.xml
EVAL_OUTPUT_DIR=eval_results
EVAL_TOP_K=10
EVAL_RUN_RAGAS=false          # Enable RAGAS metrics (requires ragas package)
EVAL_LOG_TIMING=false         # Log pipeline stage latencies

# ── Cache Settings ──────────────────────────────────────────────────────────
# Enable Redis caching for embeddings, search results, and document parsing.
# Requires the redis package: pip install redis
ENABLE_CACHE=false
REDIS_URL=redis://localhost:6379/0

# Cache TTL settings (seconds)
CACHE_TTL_EMBEDDING=86400   # 24 hours
CACHE_TTL_SEARCH=3600       # 1 hour
CACHE_TTL_PARSE=604800      # 7 days
CACHE_TTL_EXPANSION=21600   # 6 hours

# Cache memory limits
CACHE_MAX_MEMORY_MB=256
CACHE_EVICTION_POLICY=allkeys-lru  # allkeys-lru | volatile-lru | noeviction

# ── GPU (set in docker-compose.yml via NVIDIA_VISIBLE_DEVICES) ────────────────
# GPU passthrough is configured in docker-compose.yml deploy.resources.reservations.devices
# No env var needed here — NVIDIA_VISIBLE_DEVICES=all is set in docker-compose.yml
