# ══════════════════════════════════════════════════════════════════════════════
# Memex — Environment Configuration
#
# Copy to .env and customize:
#   cp .env.example .env
#
# All values are overridable. Priority: env var > .env > default in config.py
# ══════════════════════════════════════════════════════════════════════════════

# ── Service Ports (docker-compose uses these for host-side ports) ─────────────
QDRANT_PORT=6333
OLLAMA_PORT=11434
DOCLING_PORT=5001
ML_SERVICES_PORT=5002
REDIS_PORT=6379
MCP_PORT=8080

# ── Service URLs (override if not using localhost) ────────────────────────────
# DOCLING_URL=http://localhost:5001/v1/convert/source
# OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
# QDRANT_URL=http://localhost:6333
# ML_SERVICES_URL=http://localhost:5002
# REDIS_URL=redis://localhost:6379/0

# ── API Keys ──────────────────────────────────────────────────────────────────
# DOCLING_API_KEY=

# ── Models ────────────────────────────────────────────────────────────────────
EMBED_MODEL=bge-m3
CHAT_MODEL=qwen2:0.5b
RERANK_MODEL=BAAI/bge-reranker-base
SPARSE_MODEL=Qdrant/bm25
COLLECTION_NAME=memex
DENSE_DIM=1024

# ── ML Provider ───────────────────────────────────────────────────────────────
# "http" = use Docker ml-services container (GPU, recommended)
# "local" = load models in-process (needs: uv sync --extra local)
SPARSE_PROVIDER=http
RERANK_PROVIDER=http

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MIN_CHUNK_LEN=30
CHUNK_STRATEGY=recursive

# ── HTTP ──────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT=60.0
DOCLING_TIMEOUT=300.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF=0.5

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_TIMEOUT=10.0
QDRANT_MAX_RETRIES=3

# ── Search ────────────────────────────────────────────────────────────────────
SEARCH_FUSION=rrf
RERANK_ENABLED=true
SEARCH_TOP_K=20

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0

# ── Feature Toggles ───────────────────────────────────────────────────────────
ENABLE_OCR=true
ENABLE_RERANKING=true
ENABLE_CACHE=false
CHARACTER_LIMIT=25000
EMBED_BATCH_SIZE=32

# ── Query Expansion (needs CHAT_MODEL) ────────────────────────────────────────
ENABLE_QUERY_EXPANSION=false
ENABLE_HYDE=false
ENABLE_MULTI_QUERY=false
ENABLE_QUERY_REWRITE=false
HYDE_MODEL=          # empty = use CHAT_MODEL
MULTI_QUERY_COUNT=3
MULTI_QUERY_MODEL=   # empty = use CHAT_MODEL
QUERY_REWRITE_MODEL= # empty = use CHAT_MODEL

# ── Contextual Retrieval (needs CHAT_MODEL) ──────────────────────────────────
ENABLE_CONTEXTUAL_RETRIEVAL=false
CONTEXT_STRATEGY=header
CONTEXT_MODEL=       # empty = use CHAT_MODEL
CONTEXT_PREFIX_MAX_TOKENS=50
CONTEXT_BATCH_SIZE=10

# ── Metadata Enhancement (needs CHAT_MODEL) ──────────────────────────────────
ENABLE_METADATA_EXTRACTION=false
ENABLE_ENTITY_EXTRACTION=false
ENABLE_DOC_CLASSIFICATION=false
ENABLE_TOPIC_TAGGING=false
ENABLE_LANGUAGE_DETECTION=true
METADATA_MODEL=      # empty = use CHAT_MODEL
MAX_ENTITIES_PER_CHUNK=10
MAX_TOPICS_PER_CHUNK=5

# ── Caching (needs Redis) ─────────────────────────────────────────────────────
CACHE_TTL_EMBEDDING=86400
CACHE_TTL_SEARCH=3600
CACHE_TTL_PARSE=604800
CACHE_TTL_EXPANSION=21600
CACHE_MAX_MEMORY_MB=256
CACHE_EVICTION_POLICY=allkeys-lru

# ── Evaluation ────────────────────────────────────────────────────────────────
EVAL_ENABLED=false
EVAL_DATASET_PATH=tests/fixtures/evaluation.xml
EVAL_OUTPUT_DIR=eval_reports
EVAL_TOP_K=10
EVAL_RUN_RAGAS=false
EVAL_LOG_TIMING=false
