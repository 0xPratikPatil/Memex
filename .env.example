# ══════════════════════════════════════════════════════════════════════════════
# Memex — Secrets (for ${VAR} substitution in config.yaml)
#
# Copy to .env:
#   cp .env.example .env
#
# config.yaml is the single source of truth for all settings.
# This file is ONLY for secrets referenced as ${VAR} in config.yaml.
# ══════════════════════════════════════════════════════════════════════════════

# Docling API key (optional, leave empty for local deployment)
DOCLING_API_KEY=

# OpenAI API key (for openai embedding/LLM provider)
OPENAI_API_KEY=

# AWS credentials (for S3 source)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Qdrant Cloud API key (for remote vector store)
QDRANT_API_KEY=
