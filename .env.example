# ══════════════════════════════════════════════════════════════════════════════
# Memex — Environment Configuration
#
# Copy to .env and customize:
#   cp .env.example .env
#
# All values are overridable. Priority: env var > .env > default in config.py
# ══════════════════════════════════════════════════════════════════════════════

# ── Service Ports (docker-compose uses these for host-side ports) ─────────────
QDRANT_PORT=6333
OLLAMA_PORT=11434
DOCLING_PORT=5001
ML_SERVICES_PORT=5002
REDIS_PORT=6379
MCP_PORT=8080

# ── Service URLs (override if not using localhost) ────────────────────────────
# All services run in Docker — localhost URLs hit Docker port mappings, NOT host.
# DO NOT install Ollama on the host. All Ollama usage goes through Docker.
# DOCLING_URL=http://localhost:5001/v1/convert/source
# OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
# QDRANT_URL=http://localhost:6333
# ML_SERVICES_URL=http://localhost:5002
# REDIS_URL=redis://localhost:6379/0

# ── API Keys ──────────────────────────────────────────────────────────────────
# DOCLING_API_KEY=

# ── Models ────────────────────────────────────────────────────────────────────
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_MODEL_FALLBACK=bge-m3
CHAT_MODEL=qwen3.5:0.8b
RERANK_MODEL=Qwen3-Reranker-0.6B
RERANK_MODEL_FALLBACK=BAAI/bge-reranker-base
SPARSE_MODEL=Qdrant/bm25
COLLECTION_NAME=memex
DENSE_DIM=1024

# ── ML Provider ───────────────────────────────────────────────────────────────
# "http" = use Docker ml-services container (GPU, recommended)
# "local" = load models in-process (needs: uv sync --extra local)
SPARSE_PROVIDER=http
RERANK_PROVIDER=http
# RERANK_TYPE: causal-lm (Qwen3-Reranker), cross-encoder (bge-reranker-base), or auto (infer from model name)
RERANK_TYPE=auto

# ── Chunking ──────────────────────────────────────────────────────────────────
# CHUNK_TOKENIZER is the HuggingFace model ID matching the embed model.
# For qwen3-embedding use Qwen/Qwen3-Embedding-0.6B. For bge-m3 use BAAI/bge-m3.
CHUNK_TOKENIZER=Qwen/Qwen3-Embedding-0.6B
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
MIN_CHUNK_LEN=30
CHUNK_STRATEGY=hybrid
CHUNK_MERGE_PEERS=true

# ── Docling Enrichment ──────────────────────────────────────────────────────
# Code, formula, and chart enrichment need extra models in docling-serve.
# Enable selectively after verifying serve supports them.
DOCLING_ENRICH_CODE=false
DOCLING_ENRICH_FORMULA=false
DOCLING_PICTURE_CLASSIFY=true
DOCLING_CHART_EXTRACT=false
DOCLING_IMAGE_EXPORT=embedded
# DOCLING_PDF_BACKEND=             # set to dlparse_v4 for faster PDF parsing

# ── HTTP ──────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT=60.0
DOCLING_TIMEOUT=300.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF=0.5

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_TIMEOUT=10.0
QDRANT_MAX_RETRIES=3

# ── Search ────────────────────────────────────────────────────────────────────
SEARCH_TOP_K=30

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0

# ── Feature Toggles ───────────────────────────────────────────────────────────
ENABLE_OCR=true
ENABLE_RERANKING=true
ENABLE_CACHE=true
CHARACTER_LIMIT=25000
EMBED_BATCH_SIZE=64

# ── Query Expansion (needs CHAT_MODEL) ────────────────────────────────────────
ENABLE_QUERY_EXPANSION=true
ENABLE_HYDE=true
ENABLE_MULTI_QUERY=true
ENABLE_QUERY_REWRITE=true
HYDE_MODEL=
# leave empty to use CHAT_MODEL
MULTI_QUERY_COUNT=3
MULTI_QUERY_MODEL=
# leave empty to use CHAT_MODEL
QUERY_REWRITE_MODEL=
# leave empty to use CHAT_MODEL

# ── Contextual Retrieval (needs CHAT_MODEL) ──────────────────────────────────
ENABLE_CONTEXTUAL_RETRIEVAL=true
CONTEXT_STRATEGY=summary
CONTEXT_MODEL=
# leave empty to use CHAT_MODEL
CONTEXT_PREFIX_MAX_TOKENS=50
CONTEXT_BATCH_SIZE=10

# ── Metadata Enhancement (needs CHAT_MODEL) ──────────────────────────────────
ENABLE_METADATA_EXTRACTION=true
ENABLE_ENTITY_EXTRACTION=true
ENABLE_DOC_CLASSIFICATION=true
ENABLE_TOPIC_TAGGING=true
ENABLE_LANGUAGE_DETECTION=true
METADATA_MODEL=
# leave empty to use CHAT_MODEL
MAX_ENTITIES_PER_CHUNK=10
MAX_TOPICS_PER_CHUNK=5

# ── Caching (needs Redis) ─────────────────────────────────────────────────────
CACHE_TTL_EMBEDDING=86400
CACHE_TTL_SEARCH=3600
CACHE_TTL_PARSE=604800
CACHE_TTL_EXPANSION=21600
CACHE_MAX_MEMORY_MB=256
CACHE_EVICTION_POLICY=allkeys-lru

# ── Evaluation ────────────────────────────────────────────────────────────────
EVAL_ENABLED=false
EVAL_DATASET_PATH=tests/fixtures/evaluation.xml
EVAL_OUTPUT_DIR=eval_reports
EVAL_TOP_K=10
EVAL_RUN_RAGAS=false
EVAL_LOG_TIMING=false
