# ── Service URLs ──────────────────────────────────────────────────────────────
# Docker Compose uses service names; local dev uses localhost.
DOCLING_URL=http://docling:5001/v1/convert/source
OLLAMA_EMBED_URL=http://ollama:11434/api/embeddings
QDRANT_URL=http://qdrant:6333
FILE_SERVER_URL=http://fileserver:9900

# ── API Keys ──────────────────────────────────────────────────────────────────
# DOCLING_API_KEY=your-api-key-here

# ── Model / collection names ──────────────────────────────────────────────────
COLLECTION_NAME=personal_rag
EMBED_MODEL=bge-m3
RERANK_MODEL=BAAI/bge-reranker-base
SPARSE_MODEL=Qdrant/bm25
DENSE_DIM=1024

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MIN_CHUNK_LEN=30
CHUNK_STRATEGY=recursive

# ── HTTP client settings ──────────────────────────────────────────────────────
HTTP_TIMEOUT=60.0
DOCLING_TIMEOUT=300.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF=0.5

# ── Qdrant client settings ────────────────────────────────────────────────────
QDRANT_TIMEOUT=10.0
QDRANT_MAX_RETRIES=3

# ── Search settings ──────────────────────────────────────────────────────────
SEARCH_FUSION=rrf
RERANK_ENABLED=true
SEARCH_TOP_K=20

# ── MCP server settings ───────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_TRANSPORT=http

# ── Feature toggles ──────────────────────────────────────────────────────────
ENABLE_OCR=true
ENABLE_RERANKING=true

# ── Response limits ────────────────────────────────────────────────────────────
CHARACTER_LIMIT=25000

# ── Embedding batch size ─────────────────────────────────────────────────────
EMBED_BATCH_SIZE=32

# ── GPU (set in docker-compose.yml via NVIDIA_VISIBLE_DEVICES) ────────────────
# GPU passthrough is configured in docker-compose.yml deploy.resources.reservations.devices
# No env var needed here — NVIDIA_VISIBLE_DEVICES=all is set in docker-compose.yml
